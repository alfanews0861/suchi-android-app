<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.Suchi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/suchi_primary</item>
        <item name="colorPrimaryVariant">@color/suchi_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/suchi_accent</item>
        <item name="colorSecondaryVariant">@color/suchi_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/status_bar</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor" tools:targetApi="l">@color/suchi_primary</item>
        
        <!-- Customize your theme here -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Suchi.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.Suchi.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Suchi.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>