<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode -->
    <style name="Theme.Suchi" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/suchi_primary</item>
        <item name="colorPrimaryVariant">@color/suchi_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/suchi_accent</item>
        <item name="colorSecondaryVariant">@color/suchi_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/status_bar</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor" tools:targetApi="l">@color/suchi_primary_dark</item>
    </style>
</resources>